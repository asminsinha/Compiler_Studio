%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

void yyerror(const char *s);
int yylex(void);

/* =========================================================
   NODE STRUCTURE FOR BACKPATCH LISTS
   ========================================================= */

typedef struct Node Node;

struct Node {
    int quad_index;
    Node *next;
};


/* =========================================================
   QUADRUPLE / THREE-ADDRESS CODE STRUCTURE
   ========================================================= */

typedef struct {
    char op[10];
    char arg1[32];
    char arg2[32];
    char result[32];
} Quad;


/* =========================================================
   GLOBAL CODE GENERATION TABLE
   ========================================================= */

Quad quad_table[500];

int quad_count = 0;
int temp_var_count = 0;

typedef struct {
    int from_quad;
    int target_quad;
} BackpatchLog;

BackpatchLog bp_logs[200];
int bp_log_count = 0;

/* =========================================================
   HELPER FUNCTION DECLARATIONS
   ========================================================= */

int nextquad();

void emit(
    const char *op,
    const char *arg1,
    const char *arg2,
    const char *result
);

char* newtemp();

Node* makelist(int index);

Node* merge(Node *l1, Node *l2);

void backpatch(Node *list, int target_quad);

void print_tac();

void print_quads();

void execute_tac();


%}


/* =========================================================
   BISON SEMANTIC VALUE TYPES
   ========================================================= */

%union {
    char *str;

    int quad_num;

    struct {
        struct Node *truelist;
        struct Node *falselist;
    } expr;

    struct {
        struct Node *nextlist;
    } stmt;
}


/* =========================================================
   TOKENS
   ========================================================= */

%token <str> ID NUM STRING_LITERAL

%token WHILE FOR IF ELSE PRINT

%token LE GE EQ NE LT GT ASSIGN

%token PLUS MINUS MULT DIV

%token SEMI LPAREN RPAREN LBRACE RBRACE


/* =========================================================
   NON-TERMINAL TYPES
   ========================================================= */

%type <str> E

%type <expr> C

%type <stmt> S S_LIST

%type <quad_num> M

%type <stmt> N


/* =========================================================
   OPERATOR PRECEDENCE
   ========================================================= */

%left PLUS MINUS
%left MULT DIV


%%


/* =========================================================
   PROGRAM
   ========================================================= */

PROG
    : S_LIST
      {
          /*
           * Any unresolved nextlist at the end of the
           * program is patched to the first quad after
           * the program.
           */
          backpatch($1.nextlist, quad_count);

          printf(
              "\n--- GENERATING INTERMEDIATE CODE ---\n"
          );
      }
    ;


/* =========================================================
   STATEMENT LIST
   ========================================================= */

S_LIST
    : S_LIST M S
      {
          /*
           * The previous statement's unresolved jumps
           * continue at the beginning of the current statement.
           */
          backpatch($1.nextlist, $2);

          $$.nextlist = $3.nextlist;
      }

    | S
      {
          $$.nextlist = $1.nextlist;
      }
    ;


/* =========================================================
   MARKER NON-TERMINAL
   ========================================================= */

M
    : /* empty */
      {
          /*
           * M records the current quad number.
           *
           * This is the key mechanism used to remember
           * control-flow destinations during translation.
           */
          $$ = nextquad();
      }
    ;


/* =========================================================
   N
   Used for the unconditional jump generated by if/else.
   ========================================================= */

N
    : /* empty */
      {
          /*
           * Create a list containing the current quad.
           * The actual target will be determined later
           * through backpatching.
           */
          $$.nextlist = makelist(nextquad());

          emit("goto", "", "", "_");
      }
    ;


/* =========================================================
   FOR LOOP INITIALIZATION
   ========================================================= */

FOR_INIT
    : ID ASSIGN E
      {
          emit("=", $3, "", $1);
      }
    ;


/* =========================================================
   FOR LOOP STEP / INCREMENT
   ========================================================= */

FOR_STEP
    : ID ASSIGN E
      {
          emit("=", $3, "", $1);
      }
    ;


/* =========================================================
   STATEMENTS
   ========================================================= */

S
    : ID ASSIGN E SEMI
      {
          emit("=", $3, "", $1);

          $$.nextlist = NULL;
      }


    | PRINT LPAREN E RPAREN SEMI
      {
          emit("print", $3, "", "");

          $$.nextlist = NULL;
      }

    | PRINT LPAREN STRING_LITERAL RPAREN SEMI
      {
          emit("print_str", $3, "", "");
          $$.nextlist = NULL;
      }


    /* -----------------------------------------------------
       IF WITHOUT ELSE
       ----------------------------------------------------- */

    | IF LPAREN C RPAREN M LBRACE S_LIST RBRACE
      {
          /*
           * TRUE  -> beginning of IF body
           * FALSE -> statement following the IF
           */
          backpatch($3.truelist, $5);

          $$.nextlist =
              merge($3.falselist, $7.nextlist);
      }


    /* -----------------------------------------------------
       IF WITH ELSE
       ----------------------------------------------------- */

    | IF LPAREN C RPAREN M LBRACE S_LIST RBRACE
      ELSE N M LBRACE S_LIST RBRACE
      {
          /*
           * TRUE condition -> IF body
           */
          backpatch($3.truelist, $5);

          /*
           * FALSE condition -> ELSE body
           */
          backpatch($3.falselist, $11);

          /*
           * Combine:
           *
           * 1. Jumps leaving the IF body
           * 2. Jumps created by N that skip ELSE
           */
          Node *temp =
              merge($7.nextlist, $10.nextlist);

          /*
           * Then combine those with the ELSE body's
           * unresolved nextlist.
           */
          $$.nextlist =
              merge(temp, $13.nextlist);
      }


    /* WHILE LOOP */

    | WHILE LPAREN M C RPAREN M LBRACE S_LIST RBRACE
      {          
          backpatch($4.truelist, $6);
          char loop_target[16];

          sprintf(loop_target, "%d", $3);

          emit("goto", "", "", loop_target);

          /*
           * Any unresolved jump inside the loop body
           * continues to the condition.
           */
          backpatch($8.nextlist, $3);

          /*
           * FALSE exits the loop.
           */
          $$.nextlist = $4.falselist;
      }


    /* FOR LOOP */

    | FOR LPAREN FOR_INIT SEMI M C SEMI M FOR_STEP
      {
          

          char cond_target[16];

          sprintf(cond_target, "%d", $5);

          emit(
              "goto",
              "",
              "",
              cond_target
          );
      }
      RPAREN M LBRACE S_LIST RBRACE
      {
          

          backpatch(
              $6.truelist,
              $12
          );

          
          backpatch(
              $14.nextlist,
              $8
          );

          
          char step_target[16];

          sprintf(
              step_target,
              "%d",
              $8
          );
          emit(
              "goto",
              "",
              "",
              step_target
          );
          
          $$.nextlist =
              $6.falselist;
      }

    /* -----------------------------------------------------
       BLOCK
       ----------------------------------------------------- */

    | LBRACE S_LIST RBRACE
      {
          $$.nextlist = $2.nextlist;
      }
    ;


    
/* =========================================================
   BOOLEAN CONDITIONS
   =========================================================

   Every condition produces:

       TRUE LIST
       FALSE LIST

   Example:

       x < 3

   produces:

       if x < 3 goto _
       goto _

   The targets are filled later using backpatch().
   ========================================================= */

C   :LPAREN C RPAREN
    {
        /* Pass the truth and falsity lists up directly */
        $$.truelist = $2.truelist;
        $$.falselist = $2.falselist;
    }

    | E LT E
      {
          $$.truelist =
              makelist(nextquad());

          $$.falselist =
              makelist(nextquad() + 1);

          emit(
              "<",
              $1,
              $3,
              "_"
          );

          emit(
              "goto",
              "",
              "",
              "_"
          );
      }


    | E GT E
      {
          $$.truelist =
              makelist(nextquad());

          $$.falselist =
              makelist(nextquad() + 1);

          emit(
              ">",
              $1,
              $3,
              "_"
          );

          emit(
              "goto",
              "",
              "",
              "_"
          );
      }


    | E LE E
      {
          $$.truelist =
              makelist(nextquad());

          $$.falselist =
              makelist(nextquad() + 1);

          emit(
              "<=",
              $1,
              $3,
              "_"
          );

          emit(
              "goto",
              "",
              "",
              "_"
          );
      }


    | E GE E
      {
          $$.truelist =
              makelist(nextquad());

          $$.falselist =
              makelist(nextquad() + 1);

          emit(
              ">=",
              $1,
              $3,
              "_"
          );

          emit(
              "goto",
              "",
              "",
              "_"
          );
      }


    | E EQ E
      {
          $$.truelist =
              makelist(nextquad());

          $$.falselist =
              makelist(nextquad() + 1);

          emit(
              "==",
              $1,
              $3,
              "_"
          );

          emit(
              "goto",
              "",
              "",
              "_"
          );
      }


    | E NE E
      {
          $$.truelist =
              makelist(nextquad());

          $$.falselist =
              makelist(nextquad() + 1);

          emit(
              "!=",
              $1,
              $3,
              "_"
          );

          emit(
              "goto",
              "",
              "",
              "_"
          );
      }
    ;


/* =========================================================
   EXPRESSIONS
   ========================================================= */

E
    : LPAREN E RPAREN
    {
        /* Simply pass up the expression attributes */
        $$ = $2;
    }

    | E PLUS E
      {
          char *temp = newtemp();

          emit(
              "+",
              $1,
              $3,
              temp
          );

          $$ = temp;
      }


    | E MINUS E
      {
          char *temp = newtemp();

          emit(
              "-",
              $1,
              $3,
              temp
          );

          $$ = temp;
      }


    | E MULT E
      {
          char *temp = newtemp();

          emit(
              "*",
              $1,
              $3,
              temp
          );

          $$ = temp;
      }


    | E DIV E
      {
          char *temp = newtemp();

          emit(
              "/",
              $1,
              $3,
              temp
          );

          $$ = temp;
      }


    | ID
      {
          $$ = $1;
      }


    | NUM
      {
          $$ = $1;
      }
    ;


%%


/* =========================================================
   NEXT QUAD
   ========================================================= */

int nextquad() {
    return quad_count;
}


/* =========================================================
   EMIT
   ========================================================= */

void emit(
    const char *op,
    const char *arg1,
    const char *arg2,
    const char *result
) {
    if (quad_count >= 500) {
        fprintf(
            stderr,
            "ERROR: Quadruple table overflow.\n"
        );

        exit(EXIT_FAILURE);
    }

    strcpy(
        quad_table[quad_count].op,
        op
    );

    strcpy(
        quad_table[quad_count].arg1,
        arg1
    );

    strcpy(
        quad_table[quad_count].arg2,
        arg2
    );

    strcpy(
        quad_table[quad_count].result,
        result
    );

    quad_count++;
}


/* =========================================================
   TEMPORARY VARIABLE GENERATION
   ========================================================= */

char* newtemp() {

    char *temp =
        (char*)malloc(16);

    if (temp == NULL) {
        fprintf(
            stderr,
            "ERROR: Memory allocation failed.\n"
        );

        exit(EXIT_FAILURE);
    }

    sprintf(
        temp,
        "t%d",
        temp_var_count++
    );

    return temp;
}


/* =========================================================
   CREATE BACKPATCH LIST
   ========================================================= */

Node* makelist(int index) {

    Node *node =
        (Node*)malloc(sizeof(Node));

    if (node == NULL) {
        fprintf(
            stderr,
            "ERROR: Memory allocation failed.\n"
        );

        exit(EXIT_FAILURE);
    }

    node->quad_index = index;

    node->next = NULL;

    return node;
}


/* =========================================================
   MERGE BACKPATCH LISTS
   ========================================================= */

Node* merge(Node *l1, Node *l2) {

    if (!l1)
        return l2;

    if (!l2)
        return l1;

    Node *curr = l1;

    while (curr->next)
        curr = curr->next;

    curr->next = l2;

    return l1;
}


/* =========================================================
   BACKPATCH
   =========================================================

   Instead of storing:

       "goto 19"

   inside a conditional quadruple,

   we store only:

       "19"

   The TAC printer later converts this into:

       goto L19

   This keeps the internal representation clean.
   ========================================================= */

void backpatch(
    Node *list,
    int target_quad
) {

    Node *curr = list;

    while (curr) {

        char target_str[16];

        sprintf(
            target_str,
            "%d",
            target_quad
        );

        /*
         * Display the actual backpatching operation.
         * This is useful for Review 1 / viva.
         */
        if (bp_log_count < 200) {
            bp_logs[bp_log_count].from_quad = curr->quad_index;
            bp_logs[bp_log_count].target_quad = target_quad;
            bp_log_count++;
        }

        strcpy(
            quad_table[curr->quad_index].result,
            target_str
        );

        curr = curr->next;
    }
}
/* =========================================================
   PRINT BACKPATCH LOGS
   ========================================================= */

void print_backpatch_logs() {
    printf(
        "\n--- BACKPATCHING OPERATIONS ---\n"
    );

    if (bp_log_count == 0) {
        printf("No backpatching operations recorded.\n");
        return;
    }

    for (int i = 0; i < bp_log_count; i++) {
        printf(
            "BACKPATCH: Quad %d -> Quad %d\n",
            bp_logs[i].from_quad,
            bp_logs[i].target_quad
        );
    }
}

/* =========================================================
   HUMAN-READABLE THREE-ADDRESS CODE
   ========================================================= */

void print_tac() {

    printf(
        "\n--- THREE-ADDRESS CODE (TAC) ---\n"
    );

    printf(
        "----------------------------------------\n"
    );

    for (int i = 0; i < quad_count; i++) {

        Quad *q =
            &quad_table[i];

        /*
         * Label for every instruction.
         *
         * This makes control-flow translation easy
         * to demonstrate during the review.
         */
        printf(
            "L%d:\n",
            i
        );


        /* Assignment */

        if (strcmp(q->op, "=") == 0) {

            printf(
                "    %s = %s\n",
                q->result,
                q->arg1
            );
        }


        /* Print */

        else if (
            strcmp(q->op, "print") == 0
        ) {

            printf(
                "    print %s\n",
                q->arg1
            );
        }


        /* Unconditional jump */

        else if (
            strcmp(q->op, "goto") == 0
        ) {

            printf(
                "    goto L%s\n",
                q->result
            );
        }


        /* Conditional jump */

        else if (
            strcmp(q->op, "<") == 0 ||
            strcmp(q->op, ">") == 0 ||
            strcmp(q->op, "<=") == 0 ||
            strcmp(q->op, ">=") == 0 ||
            strcmp(q->op, "==") == 0 ||
            strcmp(q->op, "!=") == 0
        ) {

            printf(
                "    if %s %s %s goto L%s\n",
                q->arg1,
                q->op,
                q->arg2,
                q->result
            );
        }


        /* Arithmetic */

        else {

            printf(
                "    %s = %s %s %s\n",
                q->result,
                q->arg1,
                q->op,
                q->arg2
            );
        }
    }


    /*
     * If a conditional jump exits the program,
     * quad_count itself is a valid destination.
     */
    printf(
        "L%d:\n",
        quad_count
    );
}


/* =========================================================
   QUADRUPLE TABLE
   ========================================================= */

void print_quads() {

    printf(
        "\n--- QUADRUPLE TABLE ---\n"
    );

    printf(
        "%-8s %-8s %-8s %-8s %-12s\n",
        "Quad #",
        "Op",
        "Arg1",
        "Arg2",
        "Result"
    );

    printf(
        "--------------------------------------------------\n"
    );

    for (int i = 0; i < quad_count; i++) {

        printf(
            "%-8d %-8s %-8s %-8s %-12s\n",
            i,
            quad_table[i].op,
            quad_table[i].arg1,
            quad_table[i].arg2,
            quad_table[i].result
        );
    }
}


/* =========================================================
   SIMPLE TAC EXECUTION SIMULATOR
   ========================================================= */

typedef struct {

    char name[32];

    int val;

} Variable;


Variable symbol_table[100];

int sym_count = 0;


/* =========================================================
   GET VARIABLE VALUE
   ========================================================= */

int get_var(
    const char *name
) {

    /*
     * Numeric constant
     */
    if (
        (name[0] >= '0' && name[0] <= '9') ||
        (
            name[0] == '-' &&
            name[1] >= '0' &&
            name[1] <= '9'
        )
    ) {

        return atoi(name);
    }


    /*
     * Search symbol table
     */
    for (
        int i = 0;
        i < sym_count;
        i++
    ) {

        if (
            strcmp(
                symbol_table[i].name,
                name
            ) == 0
        ) {

            return symbol_table[i].val;
        }
    }


    /*
     * Undefined variables currently
     * default to zero.
     */
    return 0;
}


/* =========================================================
   SET VARIABLE VALUE
   ========================================================= */

void set_var(
    const char *name,
    int val
) {

    /*
     * Existing variable
     */
    for (
        int i = 0;
        i < sym_count;
        i++
    ) {

        if (
            strcmp(
                symbol_table[i].name,
                name
            ) == 0
        ) {

            symbol_table[i].val = val;

            return;
        }
    }


    /*
     * New variable
     */
    if (sym_count >= 100) {

        fprintf(
            stderr,
            "ERROR: Symbol table overflow.\n"
        );

        exit(EXIT_FAILURE);
    }


    strcpy(
        symbol_table[sym_count].name,
        name
    );

    symbol_table[sym_count].val = val;

    sym_count++;
}


/* =========================================================
   TAC EXECUTION
   ========================================================= */

void execute_tac() {

    printf(
        "\n--- RUNTIME EXECUTION OUTPUT ---\n"
    );


    int pc = 0;

    int steps = 0;


    /*
     * Step limit prevents accidental infinite loops
     * during compiler development.
     */
    while (
        pc < quad_count &&
        steps < 1000
    ) {

        steps++;


        Quad q =
            quad_table[pc];


        /*
         * Default control flow:
         *
         * execute next quad.
         */
        int next_pc =
            pc + 1;


        /* -------------------------------------------------
           ASSIGNMENT
           ------------------------------------------------- */

        if (
            strcmp(q.op, "=") == 0
        ) {

            set_var(
                q.result,
                get_var(q.arg1)
            );
        }


        /* -------------------------------------------------
           ADDITION
           ------------------------------------------------- */

        else if (
            strcmp(q.op, "+") == 0
        ) {

            set_var(
                q.result,
                get_var(q.arg1) +
                get_var(q.arg2)
            );
        }


        /* -------------------------------------------------
           SUBTRACTION
           ------------------------------------------------- */

        else if (
            strcmp(q.op, "-") == 0
        ) {

            set_var(
                q.result,
                get_var(q.arg1) -
                get_var(q.arg2)
            );
        }


        /* -------------------------------------------------
           MULTIPLICATION
           ------------------------------------------------- */

        else if (
            strcmp(q.op, "*") == 0
        ) {

            set_var(
                q.result,
                get_var(q.arg1) *
                get_var(q.arg2)
            );
        }


        /* -------------------------------------------------
           DIVISION
           ------------------------------------------------- */

        else if (
            strcmp(q.op, "/") == 0
        ) {

            int denom =
                get_var(q.arg2);

            if (denom != 0) {

                set_var(
                    q.result,
                    get_var(q.arg1) /
                    denom
                );
            }
        }


        /* -------------------------------------------------
           LESS THAN
           ------------------------------------------------- */

        else if (
            strcmp(q.op, "<") == 0
        ) {

            if (
                get_var(q.arg1) <
                get_var(q.arg2)
            ) {

                next_pc =
                    atoi(q.result);
            }
        }


        /* -------------------------------------------------
           GREATER THAN
           ------------------------------------------------- */

        else if (
            strcmp(q.op, ">") == 0
        ) {

            if (
                get_var(q.arg1) >
                get_var(q.arg2)
            ) {

                next_pc =
                    atoi(q.result);
            }
        }


        /* -------------------------------------------------
           LESS THAN OR EQUAL
           ------------------------------------------------- */

        else if (
            strcmp(q.op, "<=") == 0
        ) {

            if (
                get_var(q.arg1) <=
                get_var(q.arg2)
            ) {

                next_pc =
                    atoi(q.result);
            }
        }


        /* -------------------------------------------------
           GREATER THAN OR EQUAL
           ------------------------------------------------- */

        else if (
            strcmp(q.op, ">=") == 0
        ) {

            if (
                get_var(q.arg1) >=
                get_var(q.arg2)
            ) {

                next_pc =
                    atoi(q.result);
            }
        }


        /* -------------------------------------------------
           EQUAL
           ------------------------------------------------- */

        else if (
            strcmp(q.op, "==") == 0
        ) {

            if (
                get_var(q.arg1) ==
                get_var(q.arg2)
            ) {

                next_pc =
                    atoi(q.result);
            }
        }


        /* -------------------------------------------------
           NOT EQUAL
           ------------------------------------------------- */

        else if (
            strcmp(q.op, "!=") == 0
        ) {

            if (
                get_var(q.arg1) !=
                get_var(q.arg2)
            ) {

                next_pc =
                    atoi(q.result);
            }
        }


        /* -------------------------------------------------
           UNCONDITIONAL GOTO
           ------------------------------------------------- */

        else if (
            strcmp(q.op, "goto") == 0
        ) {

            next_pc =
                atoi(q.result);
        }


        /* -------------------------------------------------
           PRINT
           ------------------------------------------------- */

        else if (
            strcmp(q.op, "print") == 0
        ) {

            printf(
                "OUTPUT: %d\n",
                get_var(q.arg1)
            );
        }

        else if (strcmp(q.op, "print_str") == 0) {
            int len = strlen(q.arg1);
            if (len >= 2 && q.arg1[0] == '"' && q.arg1[len - 1] == '"') {
                printf("OUTPUT: %.*s\n", len - 2, q.arg1 + 1);
            } else {
                printf("OUTPUT: %s\n", q.arg1);
            }
        }


        /*
         * Move to next program counter.
         */
        pc =
            next_pc;
    }


    /* -----------------------------------------------------
       LOOP SAFETY WARNING
       ----------------------------------------------------- */

    if (steps >= 1000) {

        printf(
            "\nWARNING: Execution stopped after "
            "1000 TAC steps.\n"
        );

        printf(
            "Possible infinite loop detected.\n"
        );
    }


    /* -----------------------------------------------------
       FINAL MEMORY STATE
       ----------------------------------------------------- */

    printf(
        "\nFinal Memory State (Variables):\n"
    );

    for (
        int i = 0;
        i < sym_count;
        i++
    ) {

        /*
         * Hide compiler-generated temporaries.
         */
        if (
            symbol_table[i].name[0] != 't'
        ) {

            printf(
                "  %s = %d\n",
                symbol_table[i].name,
                symbol_table[i].val
            );
        }
    }
}


/* =========================================================
   ERROR HANDLER
   ========================================================= */

void yyerror(
    const char *s
) {

    fprintf(
        stderr,
        "COMPILATION ERROR: %s\n",
        s
    );
}


/* =========================================================
   MAIN
   ========================================================= */

int main() {

    /*
     * yyparse() reads source code from stdin.
     *
     * Therefore both of these work:
     *
     *     ./compiler
     *
     * or:
     *
     *     ./compiler < input.txt
     */

    if (yyparse() == 0) {
        
        /*
         * Print backpatch log summary after input stream finishes
         */
        print_backpatch_logs();
        
        /*
         * Human-readable TAC
         */
        print_tac();

        /*
         * Internal quadruple representation
         */
        print_quads();

        /*
         * Execute generated intermediate code
         */
        execute_tac();
    }

    return 0;
}